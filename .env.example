# Free-tier LLM providers. Add the keys you have; the pipeline uses whichever are set.
NVIDIA_API_KEY="your_key_here"      # build.nvidia.com  (planner, answer and judge by default)
# GROQ_API_KEY="your_key_here"      # console.groq.com  (optional)
GEMINI_API_KEY="your_key_here"      # aistudio.google.com (automatic fallback if NVIDIA fails)
# OPENROUTER_API_KEY="your_key_here"
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Which model does which job: "provider" or "provider:model".
# Unset roles use the first provider with a key, in the order nvidia, groq, gemini, openrouter.
# On NVIDIA the judge uses a different model family (GLM) from the answer model (Nemotron).
# MEDX_PLANNER_LLM=nvidia
# MEDX_ANSWER_LLM=nvidia
# MEDX_JUDGE_LLM=nvidia:z-ai/glm-5.3-flash
# If a call fails outright, the next provider with a key is tried; MEDX_FALLBACK=0 disables that
# (use it for evaluations where every answer must come from one model).
# MEDX_FALLBACK=1

# Per-provider default models and request-per-minute pacing (optional).
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_JUDGE_MODEL=z-ai/glm-5.3-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-3.8-flash
# NVIDIA_RPM=20
# GROQ_RPM=25
# GEMINI_RPM=8
